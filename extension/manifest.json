{
  "manifest_version": 3,
  "name": "GWS Tweaks",
  "version": "0.2.0",
  "description": "Google Workspace にちょっとした便利機能を追加します。",
  "key": "",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage", "identity"],
  "host_permissions": ["https://www.googleapis.com/*", "https://docs.googleapis.com/*"],
  "oauth2": {
    "client_id": "102198490504-dlk5n6b755njoef77cq6796co0pbmvet.apps.googleusercontent.com",
    "scopes": [
      "https://www.googleapis.com/auth/drive.metadata.readonly",
      "https://www.googleapis.com/auth/documents"
    ]
  },
  "background": {
    "service_worker": "src/background/service-worker.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://docs.google.com/document/*",
        "https://docs.google.com/spreadsheets/*",
        "https://docs.google.com/presentation/*"
      ],
      "js": [
        "src/lib/markdown-paste.js",
        "src/lib/breadcrumb.js",
        "src/lib/doc-setup.js",
        "src/lib/features.js",
        "src/content/main.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "options_ui": {
    "page": "src/options/options.html",
    "open_in_tab": true
  }
}
